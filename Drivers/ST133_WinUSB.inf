[Version]
Signature = "$Windows NT$"
Class = USBDevice
ClassGUID = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider = "Princeton Instruments / SpectroSuite"
DriverVer = 08/25/2026, 1.0.0.0
CatalogFile = ST133_WinUSB.cat

[Manufacturer]
%ManufacturerName% = Standard, NTamd64

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_0BD7&PID_A010

[USB_Install]
Include = winusb.inf
Needs = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
AddService = WinUSB, 0x00000002, WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName     = %WinUSB_SvcDesc%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

[USB_Install.Wdf]
KmdfService = WINUSB, WinUSB_Install

[WinUSB_Install]
KmdfLibraryVersion = 1.11

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{3972c010-8ea9-4939-926e-8a9db35ba0a6}","{dee824ef-729b-4a0e-9c14-b7117d33a817}"

[Strings]
ManufacturerName = "Princeton Instruments"
DeviceName       = "Princeton Instruments ST-133 InGaAs Controller (WinUSB)"
WinUSB_SvcDesc   = "WinUSB Driver Service for ST-133"
