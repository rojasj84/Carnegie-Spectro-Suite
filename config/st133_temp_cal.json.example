{
  "_comment": "ST-133 / OMA-V InGaAs temperature calibration for st133_libusb.py. Copy to 'st133_temp_cal.json' (same folder). The 0x46 low byte is a live value; the working model is T_C = room_c - adc_byte (slope -1, offset = room temperature). Pick ONE of the keys below. If no file is present the default is room_c = 25 (status PROVISIONAL).",

  "_option_1_room_offset": "keep the room_c - adc model, just set your lab temperature:",
  "room_c": 25.0,

  "_option_2_two_point_fit": "delete room_c and use >=2 [adc_low_byte, celsius] pairs (read raw_adc from get_temperature() or the GUI 'ADC nn' text, pair with WinSpec32's live displayed temp at a couple of points during cool-down) -> linear fit, status OK:",
  "_points_example": [[93, -68.0], [122, -98.0]],

  "_option_3_explicit_poly": "delete the others and give [m, b] for T = m*adc + b:",
  "_poly_example": [-1.0, 25.0]
}
